{
  "name": "pokerogue-offline-electron",
  "version": "0.1.2",
  "private": true,
  "author": "gaboopa",
  "type": "module",
  "main": "src/main.mjs",
  "description": "Offline Electron wrapper for PokeRogue",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:game": "node scripts/build-game.mjs",
    "run:packaged": "electron .",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "test": "node --test test/*.test.mjs",
    "package:win": "npm run build:game && electron-builder --win nsis --x64",
    "package:mac": "npm run build:game && electron-builder --mac dmg --arm64",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.gaboopa.pokerogueoffline",
    "productName": "PokeRogue Offline",
    "asar": true,
    "compression": "store",
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "staging/game",
        "to": "game"
      },
      {
        "from": "staging/revisions.json",
        "to": "revisions.json"
      },
      {
        "from": "staging/licenses",
        "to": "licenses"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PokeRogue-Offline-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "PokeRogue Offline"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "PokeRogue-Offline-${version}-macos-arm64.${ext}",
      "identity": null,
      "category": "public.app-category.games"
    }
  },
  "allowScripts": {
    "electron@42.7.1": true
  }
}
