{
  "name": "pokerogue-offline-electron",
  "version": "0.1.4",
  "private": true,
  "author": "gaboopa",
  "type": "module",
  "main": "src/bootstrap.mjs",
  "description": "Offline Electron wrapper for PokeRogue",
  "scripts": {
    "dev": "npm run build:game && electron .",
    "build:game": "node scripts/build-game.mjs",
    "stage:game": "node scripts/build-game.mjs --stage-only",
    "run:packaged": "electron .",
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "test": "electron --version && node --test test/*.test.mjs",
    "package:win": "npm run build:game && node scripts/package-win.mjs release",
    "package:win:smoke": "node scripts/package-win.mjs smoke",
    "package:win:staged": "node scripts/package-win.mjs staged",
    "package:mac": "npm run build:game && electron-builder --mac dmg --arm64",
    "package:mac:local": "node scripts/package-mac-local.mjs",
    "release:manifest": "node scripts/release-manifest.mjs"
  },
  "devDependencies": {
    "electron": "^42.11.10",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.gaboopa.pokerogueoffline",
    "productName": "PokeRogue Electron",
    "asar": true,
    "compression": "store",
    "files": [
      "src/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "staging/game",
        "to": "game"
      },
      {
        "from": "staging/revisions.json",
        "to": "revisions.json"
      },
      {
        "from": "staging/licenses",
        "to": "licenses"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PokeRogue-Offline-${version}-windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "PokeRogue Electron"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "PokeRogue-Offline-${version}-macos-arm64.${ext}",
      "identity": null,
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.games"
    },
    "dmg": {
      "sign": false,
      "filesystem": "HFS+",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "allowScripts": {
    "electron@42.11.10": true
  }
}
